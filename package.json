{
  "name": "limitbreak_v2_platform",
  "version": "1.0.0",
  "main": "./server.js",
  "scripts": {
    "postinstall": "npm install --prefix client && npm start",
    "dev": "npm start",
    "dev:server": "nodemon server.js",
    "dev:client": "npm run dev --prefix client",
    "start": "cross-env NODE_OPTIONS=--no-deprecation concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "chain:compile": "hardhat compile",
    "chain:test": "hardhat test",
    "chain:node": "hardhat node",
    "chain:deploy": "hardhat run scripts/deploy.js --network localhost"
  },
  "private": true,
  "description": "Limit Break V2 — accessible Web3 gaming product shell",
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-mongo-sanitize": "^2.0.0",
    "express-rate-limit": "^5.1.3",
    "express-validator": "^6.6.1",
    "express-xss-sanitizer": "^2.0.1",
    "helmet": "^4.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^6.13.6",
    "ethers": "^6.16.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.6"
  },
  "devDependencies": {
    "concurrently": "^5.3.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.9",
    "hardhat": "^2.22.17",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.2.0"
  }
}
